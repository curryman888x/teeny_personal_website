# Copy to .env for local overrides. All optional.

# Base path for the build.
#   "/"                       user site (curryman888x.github.io) or custom domain
#   "/teeny_personal_website/"  GitHub project page (the deploy workflow sets this)
VITE_BASE=/

# Contact form target. A Formspree (or compatible) endpoint URL.
# Leave empty and the Contact section just shows your email + social links.
VITE_FORMSPREE_ENDPOINT=
